<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FiscalService.Api</RootNamespace>
    <AssemblyName>FiscalService.Api</AssemblyName>
    <Version>1.1.1</Version>
    <InformationalVersion>1.1.1</InformationalVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
  </PropertyGroup>

  <ItemGroup>
    <!-- DANFE NF-e (modelo 55) — PdfSharpCore, Linux/Docker -->
    <PackageReference Include="Danfe.NFe.Core" Version="2.0.1" />

    <!-- EF Core + PostgreSQL -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.*">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.*" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="8.*" />

    <!-- NFS-e Padrão Nacional (ADN) — isolado do Zeus/SEFAZ -->
    <PackageReference Include="OpenAC.Net.NFSe.Nacional" Version="1.5.0" />
    <PackageReference Include="OpenAC.Net.NFSe.Nacional.DANFSe.PDFSharp" Version="1.0.0" />

    <!-- DFe.NET: NFe/NFCe/CTe/MDFe. Pin Zeus 2026.8.18.2047 -->
    <PackageReference Include="Zeus.Net.NFe.NFCe" Version="2026.8.18.2047" />
    <PackageReference Include="Zeus.Net.CTe" Version="2026.8.18.2047" />
    <PackageReference Include="Zeus.Net.MDFe" Version="2026.8.18.2047" />

    <!-- Swagger / OpenAPI -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.*" />

    <!-- Logs -->
    <PackageReference Include="Serilog.AspNetCore" Version="8.*" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.*" />
    <!-- Console 5.x requerido pelo Serilog.AspNetCore 8.x -->
    <PackageReference Include="Serilog.Sinks.Console" Version="5.*" />

    <!-- Health Checks -->
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" Version="8.*" />

    <!-- Carrega .env antes do host (dotnet run / IDE) -->
    <PackageReference Include="DotNetEnv" Version="3.*" />

    <!-- Validação de entrada (além de DataAnnotations nos modelos) -->
    <PackageReference Include="FluentValidation.AspNetCore" Version="11.*" />

    <!-- Observabilidade (OTLP — ativo quando houver endpoint configurado) -->
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.15.3" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.15.3" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.15.2" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.15.1" />
  </ItemGroup>

  <!-- Schemas XSD do DFe.NET — copiados para o output -->
  <ItemGroup>
    <Content Include="Schemas\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\nfse\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\docs\exemplos\**\*.json" LinkBase="docs\exemplos">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FiscalService.Api.Tests" />
  </ItemGroup>

</Project>
