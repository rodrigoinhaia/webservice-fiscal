# Copie para scripts/config/producao.env (não versionar) e preencha.
# Usado por scripts/smoke-producao.ps1

# URL base do FiscalService em produção (sem barra final)
SMOKE_BASE_URL=https://seu-fiscal.easypanel.host

# API Key (header X-Api-Key)
SMOKE_API_KEY=troque_pela_api_key

# CNPJ do emitente cadastrado no webservice (14 dígitos)
SMOKE_CNPJ=12531172000170

# Séries em produção (ajuste conforme cadastro)
SMOKE_SERIE_NFE=3
SMOKE_SERIE_NFCE=2
SMOKE_SERIE_NFSE=1

# NFC-e — opcional se CSC já estiver cadastrado no emitente (idCscProducao/cscProducao)
# SMOKE_ID_CSC=1
# SMOKE_CSC=seu_csc_producao

# Modelo padrão: NFe | NFCe | NFSe | Todos
SMOKE_MODELO=NFSe
